[Unit]
Description=McQueen phone control and local dataset recorder
Requires=mcqueen-mcu.service arduino-router.service
After=mcqueen-mcu.service arduino-router.service network.target

[Service]
Type=simple
User=arduino
Group=arduino
Environment=HOME=/home/arduino
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/arduino/McQueen
ExecStart=/home/arduino/McQueen/.venv/bin/python /home/arduino/McQueen/app.py
Restart=always
RestartSec=5
TimeoutStopSec=8

[Install]
WantedBy=multi-user.target
