[Unit]
Description=McQueen synchronized 1080p RGB depth YOLO uploader
Requires=mcqueen-teleop.service
After=mcqueen-teleop.service network.target

[Service]
Type=simple
User=arduino
Group=arduino
Environment=HOME=/home/arduino
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/arduino/McQueen/vision
ExecStart=/home/arduino/McQueen/teleop/.venv/bin/python3 /home/arduino/McQueen/vision/goal2_logger.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
