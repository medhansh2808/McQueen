[Unit]
Description=Load McQueen firmware onto UNO Q STM32
Requires=arduino-router.service
After=arduino-router.service
Before=mcqueen-teleop.service

[Service]
Type=oneshot
User=arduino
Group=arduino
Environment=HOME=/home/arduino
WorkingDirectory=/home/arduino/McQueenUnoQTeleop
ExecStartPre=/bin/sleep 3
ExecStart=/home/arduino/McQueenUnoQTeleop/scripts/flash_mcu.sh
ExecStartPost=/bin/sleep 5
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
