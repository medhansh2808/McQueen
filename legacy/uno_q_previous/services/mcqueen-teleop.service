[Unit]
Description=McQueen UNO Q phone teleoperation receiver
After=network.target arduino-router.service
Requires=arduino-router.service

[Service]
Type=simple
User=arduino
Group=arduino
WorkingDirectory=/home/arduino/McQueen/teleop
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/arduino/McQueen/teleop/.venv/bin/python3 /home/arduino/McQueen/teleop/linux/unoq_udp_receiver.py --bind 0.0.0.0 --port 5007 --failsafe-ms 300
Restart=on-failure
RestartSec=2
TimeoutStopSec=3

[Install]
WantedBy=multi-user.target
