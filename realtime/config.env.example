# McQueen realtime stack — per-host configuration.
#
# Copy to realtime/config.env on EACH host and edit. config.env is gitignored,
# because every value in it is host- or session-specific. Nothing in the
# tracked scripts hardcodes a path, a camera, a servo trim or a tunnel URL.
#
#   cp realtime/config.env.example realtime/config.env && $EDITOR realtime/config.env

# ---------------------------------------------------------------- shared ----
# Session name both peers join on the broker. Must match on RTX and Jetson.
MCQUEEN_SESSION=mcqueen

# Broker hostname WITHOUT scheme, e.g. abc-def-ghi.trycloudflare.com
# The Cloudflare quick tunnel mints a new random hostname on every restart, so
# this goes stale constantly. On the RTX leave it EMPTY — start_stack.sh reads
# the live value out of the tunnel log. On the Jetson set it, or pass
# --broker-host to go_autonomy_jetson.sh, which overrides this.
MCQUEEN_BROKER_HOST=

# --------------------------------------------------------------- jetson ----
# Camera by stable by-id path (NOT /dev/videoN — that renumbers across reboots).
MCQUEEN_CAM=/dev/v4l/by-id/usb-Sonix_Technology_Co.__Ltd._Lenovo_FHD_Webcam_Audio_SN0001-video-index0

# Servo pulse trim, microseconds. LEFT > RIGHT here is correct for this car:
# the physical linkage inverts, and the sender applies a matching steering flip.
# Do not "fix" one without re-measuring the other on the bench.
MCQUEEN_SERVO_LEFT_US=1750
MCQUEEN_SERVO_CENTER_US=1500
MCQUEEN_SERVO_RIGHT_US=1275

MCQUEEN_BITRATE_KBPS=400
MCQUEEN_EDGE_ADDR=127.0.0.1:5007

# ------------------------------------------------------------------ rtx ----
# Scratch dir holding logs, the cloudflared binary and the tunnel logs.
MCQUEEN_RUNTIME_DIR=/var/tmp/mcqueen-junior

# Python for the policy worker and the RTP receiver.
# Needs: torch, onnxruntime-gpu, websocket-client, PyGObject/GStreamer.
MCQUEEN_PY=/var/tmp/mcqueen-junior/gst-webrtc-venv/bin/python

# Python for the broker. Deliberately a SEPARATE interpreter: the broker needs
# aiohttp, which is not installed in the GStreamer venv, and that venv holds the
# CUDA torch/onnxruntime build the worker needs. Keeping them apart avoids
# reconciling those dependency sets. Defaults to MCQUEEN_PY if unset.
MCQUEEN_BROKER_PY=/home/junior/mcqueen/envs/mcqueen-openpilot/bin/python

# Trained action head checkpoint.
MCQUEEN_CKPT=/home/junior/mcqueen/run/real_head_v4_seed2.pt

# Trunk ONNX *base* path. rtx_policy_v1 appends "_ks" to get the ORT-patched
# variant that actually loads, so point this at the base name even though only
# the _ks file exists on disk.
MCQUEEN_ONNX=/home/junior/mcqueen/models/big_driving_supercombo.onnx

# Dir holding train_frozen_action.py and action_adapter.py (head definitions).
MCQUEEN_MODELS_DIR=/home/junior/mcqueen/models

MCQUEEN_POLICY_PORT=9801
MCQUEEN_BROKER_PORT=8765
MCQUEEN_JITTER_MS=30

# Nvidia lib dir for LD_LIBRARY_PATH (cudnn/cublas/cuda_runtime live under it).
MCQUEEN_NVIDIA_LIBS=/home/junior/.local/lib/python3.10/site-packages/nvidia
